# Public — safe to expose to the browser
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Server-only
SUPABASE_SERVICE_ROLE_KEY=
# Not read by the app. Kept here because minting a member JWT is how RLS is
# probed against a real project — see CLAUDE.md, "Minting a member JWT".
SUPABASE_JWT_SECRET=

# LINE Login (https://developers.line.biz/console/)
LINE_CHANNEL_ID=
LINE_CHANNEL_SECRET=

# LINE Messaging API — the Parea bot. SEPARATE channel from LINE Login above,
# but it must sit under the same LINE provider so webhook userIds match
# private_profiles.line_sub. Unset = the bot and the weekly digest are off.
LINE_MESSAGING_CHANNEL_SECRET=
LINE_MESSAGING_ACCESS_TOKEN=
# Deliberately left unset in production: passive @parea group Q&A is a settled
# "permanently off" (see CLAUDE.md). The bot is in the group for the weekly
# digest only. Setting this switches in-group question-answering back on.
LINE_GROUP_ID=

# Parea Concierge. Unset = /api/concierge returns 503 and the bot declines.
ANTHROPIC_API_KEY=
# Monthly hard spend cap in USD (default 5).
CONCIERGE_MONTHLY_BUDGET_USD=

# Google OAuth (Supabase-managed, but document for reference)
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=

# Google Maps Platform (server-side helpers; same key as NEXT_PUBLIC_ but with stricter restrictions OK)
GOOGLE_MAPS_API_KEY=

# Optional: shared community Drive folder linked from the header "Files" nav
# item. Left unset, the nav item just doesn't render.
COMMUNITY_FILES_URL=

# Weekly-digest cron auth. Set the SAME value in the Vercel env — Vercel Cron
# then sends it as `Authorization: Bearer <CRON_SECRET>` automatically.
# Without it the digest route 401s every call (fails closed).
CRON_SECRET=
